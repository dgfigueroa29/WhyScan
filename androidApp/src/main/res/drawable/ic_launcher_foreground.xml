<?xml version="1.0" encoding="utf-8"?>
<!--
    Capa de primer plano del icono adaptativo: la marca de WhyScan —el módulo fugado—, la misma
    forma que dibuja `WhyScanMark` en `:core:designsystem`. Están duplicadas porque viven en dos
    mundos que no se hablan —Compose y el sistema de recursos de Android—, y por eso las tres copias
    (esta, la monocroma y el `ImageVector`) llevan esta nota: quien toque una tiene que tocar las
    otras dos.

    El lienzo es de 108dp pero **el contenido no puede ocupar los 108**. El sistema recorta esta capa
    con una máscara que el fabricante elige, y la única zona garantizada es un círculo de 72dp de
    diámetro centrado. La marca ocupa 48dp centrados (30..78): su esquina más lejana queda a 33.9dp
    del centro, por debajo de los 36 del radio seguro, así que no se recorta ni con máscara redonda.

    Las coordenadas salen de escalar la rejilla de 24 de `WhyScanMark` por 2.7746 y desplazarla
    20.84, que es lo que lleva su caja de 17.3 unidades a 48dp centrados.

    El módulo va en el color de acento y el anillo en blanco. Es lo único que se pierde en la capa
    monocroma, y por eso las dos piezas están separadas por forma además de por color.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- El anillo del patrón de localización, abierto por la esquina inferior derecha. -->
    <path
        android:pathData="M38.6,33.1 L63.6,33.1 A5.5,5.5 0 0 1 69.1,38.6 L69.1,49.7 M49.7,69.1 L38.6,69.1 A5.5,5.5 0 0 1 33.1,63.6 L33.1,38.6 A5.5,5.5 0 0 1 38.6,33.1"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- El módulo, ya fuera del anillo. -->
    <path
        android:pathData="M63,58 L73,58 A5,5 0 0 1 78,63 L78,73 A5,5 0 0 1 73,78 L63,78 A5,5 0 0 1 58,73 L58,63 A5,5 0 0 1 63,58 Z"
        android:fillColor="#5FD9A5" />
</vector>
