<?xml version="1.0" encoding="utf-8"?>
<!--
    Capa monocroma para los iconos temáticos de Android 13+.

    Cuando el usuario activa "icono temático", el sistema descarta fondo y primer plano y pinta
    **esta** capa con los colores de su fondo de pantalla. Sin declararla, WhyScan sería de las
    aplicaciones que se quedan con su icono a todo color en una pantalla en la que el resto se ha
    teñido, que es justo lo que delata una app que no se revisó para la versión actual.

    El color es negro por convención: el sistema lo sustituye, así que solo importa la silueta.

    Y aquí es donde la marca se juega su legibilidad. Al pintarse todo del mismo color, el anillo y
    el módulo pierden el contraste que en el icono a color los distingue, así que **la separación
    entre las dos piezas es lo único que queda**: la brecha del anillo termina en 49.7 y el módulo
    empieza en 58. Acercarlos funde las dos formas en una mancha y la marca deja de contar nada.

    Es la misma forma que `WhyScanMark` en `:core:designsystem` y que `ic_launcher_foreground.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M38.6,33.1 L63.6,33.1 A5.5,5.5 0 0 1 69.1,38.6 L69.1,49.7 M49.7,69.1 L38.6,69.1 A5.5,5.5 0 0 1 33.1,63.6 L33.1,38.6 A5.5,5.5 0 0 1 38.6,33.1"
        android:strokeColor="#000000"
        android:strokeWidth="6.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M63,58 L73,58 A5,5 0 0 1 78,63 L78,73 A5,5 0 0 1 73,78 L63,78 A5,5 0 0 1 58,73 L58,63 A5,5 0 0 1 63,58 Z"
        android:fillColor="#000000" />
</vector>
